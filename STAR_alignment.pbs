#!/bin/bash

#PBS -N STAR_alignment
#PBS -l select=1:ncpus=8:mem=80gb
#PBS -l walltime=11:59:00
#PBS -j oe
#PBS -M user@email.com
#PBS -m ae
#PBS -J 0-16

PARAMS=(AD1 AD2 AD3 AD4 AD5 AD6 AD7 AD8 AD9 AD_control1 AD_control2 AD_control3 AD_control4 AD_control5 AD_control6 AD_control7 AD_control8)

module load star/2.7.11b
mkdir /path/to/directory/${PARAMS[$PBS_ARRAY_INDEX]}
cd /path/to/directory/${PARAMS[$PBS_ARRAY_INDEX]}

STAR --runThreadN 8 --genomeDir /path/to/directory/Homo_sapiens/UCSC/hg38/Sequence/STAR_index --outSAMtype BAM SortedByCoordinate --readFilesIn /path/to/directory/${PARAMS[$PBS_ARRAY_INDEX]}_1_paired.fastq.gz /path/to/directory/${PARAMS[$PBS_ARRAY_INDEX]}_2_paired.fastq.gz --readFilesCommand zcat --outTmpDir $TMPDIR/star --outFileNamePrefix ${PARAMS[$PBS_ARRAY_INDEX]}_Star --sjdbGTFfile /path/to/directory/Homo_sapiens/gencode.v49.annotation.gtf --sjdbOverhang 124 --outReadsUnmapped Fastx --outSJfilterOverhangMin 15 15 15 15 --alignSJoverhangMin 15 --alignSJDBoverhangMin 15 --outFilterMultimapNmax 20 --outFilterScoreMin 1 --outFilterMatchNmin 1 --outFilterMismatchNmax 2 --chimSegmentMin 15 --chimScoreMin 15 --chimScoreSeparation 10 --chimJunctionOverhangMin 15
