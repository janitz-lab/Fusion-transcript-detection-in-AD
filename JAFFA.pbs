#!/bin/bash

#PBS -N JAFFA_alignment
#PBS -l select=1:ncpus=16:mem=100gb,walltime=96:00:00 
#PBS -j oe
#PBS -M user@email.com
#PBS -m ae
#PBS -J 0-16


PARAMS=(AD1 AD2 AD3 AD4 AD5 AD6 AD7 AD8 AD9 AD_control1 AD_control2 AD_control3 AD_control4 AD_control5 AD_control6 AD_control7 AD_control8)

module load r/4.5.3
module load gcc/15.2

cd /path/to/directory/${PARAMS[$PBS_ARRAY_INDEX]}

/path/to/directory/JAFFA-version-2.3/tools/bin/bpipe run /path/to/directory/JAFFA-version-2.3/JAFFA_direct.groovy /path/to/directory/${PARAMS[$PBS_ARRAY_INDEX]}_*_paired.fastq.gz

mv /path/to/directory/${PARAMS[$PBS_ARRAY_INDEX]}/jaffa_results.csv /path/to/directory/${PARAMS[$PBS_ARRAY_INDEX]}/${PARAMS[$PBS_ARRAY_INDEX]}_jaffa_results.csv

mv /path/to/directory/${PARAMS[$PBS_ARRAY_INDEX]}/jaffa_results.fasta /path/to/directory${PARAMS[$PBS_ARRAY_INDEX]}/${PARAMS[$PBS_ARRAY_INDEX]}_jaffa_results.fasta
